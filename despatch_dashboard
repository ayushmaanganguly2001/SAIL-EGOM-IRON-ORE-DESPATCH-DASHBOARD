with t_remarks:
    st.subheader("Remarks / reasons")
    if remark_df.empty:
        st.info("None found.")
    else:
        term = st.text_input("Search remarks", placeholder="e.g. rake, power, "
                                                           "belt, siding")
        view = remark_df
        if term.strip():
            view = remark_df[remark_df["Remark"]
                             .str.contains(term.strip(), case=False, na=False)]

        st.caption(f"{len(view)} of {len(remark_df)} remarks shown.")
        mine_words = {MINE_NAMES.get(c, c): c for c in MINE_ORDER}
        mine_words.update({"Kuteshwar": "KTR"})

        for day_label, block in view.groupby("Date", sort=False):
            items = []
            for text in block["Remark"]:
                tags = [name for name in mine_words
                        if name.lower() in str(text).lower()]
                chips = "".join(f'<span class="rmk-tag">{t}</span>'
                                for t in tags)
                items.append(f'<div class="rmk-item">{chips}{text}</div>')
            st.markdown(
                f'<div class="rmk-card"><div class="rmk-date">{day_label}'
                f'</div>{"".join(items)}</div>', unsafe_allow_html=True)

        excel_button(view, "Remarks", "remarks_table")

        with st.expander("Remarks as a table"):
            st.dataframe(view, hide_index=True, **FULL)

        words = (remark_df["Remark"].str.lower()
                 .str.findall(r"[a-z]{5,}").explode().dropna())
        stop = {"rakes", "rake", "today", "despatch", "plan", "against",
                "total", "mines", "there", "which", "their", "because"}
        words = words[~words.isin(stop)]
        if not words.empty:
            top = words.value_counts().head(12).rename("Mentions")
            with st.expander("Most frequent words in remarks"):
                chart(top.to_frame(), "Remark Words", "remark_words", "bar", 280)

