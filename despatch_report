def write_csv(s: Summary, path: str) -> None:
    with open(path, "w", newline="", encoding="utf-8") as fh:
        w = csv.writer(fh)
        w.writerow(["Date", "Despatch", "COD Plan", "Variance", "Achievement %",
                    "Cumulative", "KTR dest", "KTR rakes"])
        for r in s.records:
            w.writerow([r.label, r.total, r.plan, r.variance,
                        round(r.achievement, 1) if r.achievement else "",
                        r.cumulative, r.ktr_dest, r.ktr_rakes])
        w.writerow([])
        w.writerow(["Mine", "Name", "Group", "Despatch", "COD Plan",
                    "Achievement %", "% Share"])
        for r in s.mine_rows():
            w.writerow([r["Mine"], r["Name"], r["Group"], r["Despatch"],
                        r["COD Plan"], r["Achievement %"], r["% Share"]])
    print(f"CSV written  : {path}")


