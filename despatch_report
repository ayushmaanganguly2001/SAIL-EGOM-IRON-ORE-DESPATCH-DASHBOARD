@dataclass
class Mine:
    code: str
    rakes: int = 0
    cod: float = 0.0
    dest: dict[str, float] = field(default_factory=dict)   # plant -> rakes
    lump: float = 0.0
    fines: float = 0.0
    others: float = 0.0       # an OTH tag with no Sales/Pellets label
    sales: float = 0.0        # from the mine's own "Sales:" line
    pellets: float = 0.0      # from the mine's own "Pellets :" line
    # Plant a/c behind the conversion, e.g. Pellets : 1FBSL 1FRSP 2FISP.
    pellet_accounts: dict[str, float] = field(default_factory=dict)
    sales_accounts: dict[str, float] = field(default_factory=dict)

    @property
    def name(self) -> str:
        return MINE_NAMES.get(self.code, self.code)

    @property
    def direct(self) -> float:
        """Rakes sent straight to a plant, i.e. excluding sales and pellets."""
        return round(sum(self.dest.values()), 2)

    @property
    def conversion(self) -> float:
        return round(self.sales + self.pellets + self.others, 2)

    @property
    def allocated(self) -> float:
        return round(self.direct + self.conversion, 2)

    @property
    def unallocated(self) -> float:
        return round(self.rakes - self.allocated, 2)


@dataclass
class Plant:
    code: str
    rakes: float = 0.0
    lump: float = 0.0
    fines: float = 0.0
    cod: float = 0.0
    accounts: dict[str, float] = field(default_factory=dict)


@dataclass
class Record:
    day: date
    label: str
    raw: str = ""
    total: float = 0.0                      # Total Rakes
    plan: float = 0.0                       # day's COD plan
    mth_avg: float = 0.0                    # month avg as stated
    cumulative: float = 0.0                 # MTD as stated in the message
    mines: dict[str, Mine] = field(default_factory=dict)
    groups: dict[str, dict] = field(default_factory=dict)
    plants: dict[str, Plant] = field(default_factory=dict)
    rake_types: dict[str, int] = field(default_factory=dict)
    rake_type_dest: dict[str, dict[str, float]] = field(default_factory=dict)
    ktr_dest: str = ""
    ktr_rakes: float = 0.0
    remarks: list[str] = field(default_factory=list)
    unparsed: list[str] = field(default_factory=list)

    # ---- calendar ---------------------------------------------------------
    @property
    def month_key(self) -> str:
        return f"{self.day.year}-{self.day.month:02d}"

    @property
    def month_name(self) -> str:
        return month_label(self.day)

    @property
    def day_name(self) -> str:
        """Mon / Tue / ... - fixed English abbreviations, locale independent."""
        return DAY_ABBR[self.day.weekday()]

    @property
    def fy(self) -> str:
        return fy_label(self.day)

    @property
    def quarter(self) -> str:
        return quarter_label(self.day)

    @property
    def week(self) -> str:
        return week_label(self.day)

    @property
    def week_key(self) -> tuple:
        start, _ = week_bounds(self.day)
        return (start.year, start.month, start.day)

    # ---- performance ------------------------------------------------------
    @property
    def variance(self) -> float:
        return self.total - self.plan

    @property
    def achievement(self) -> float | None:
        return (self.total / self.plan * 100) if self.plan else None

    @property
    def core_plant_total(self) -> float:
        return round(sum(p.rakes for c, p in self.plants.items()
                         if c in CORE_PLANTS), 2)

    @property
    def conversion_total(self) -> float:
        return round(sum(p.rakes for c, p in self.plants.items()
                         if c in CONVERSION_PLANTS), 2)

    @property
    def sales_rakes(self) -> float:
        p = self.plants.get("Sales")
        return p.rakes if p else 0.0

    @property
    def pellet_rakes(self) -> float:
        p = self.plants.get("Pellets")
        return p.rakes if p else 0.0

    @property
    def pellet_accounts(self) -> dict[str, float]:
        p = self.plants.get("Pellets")
        return dict(p.accounts) if p else {}

    @property
    def sales_accounts(self) -> dict[str, float]:
        p = self.plants.get("Sales")
        return dict(p.accounts) if p else {}

    # ---- data quality -----------------------------------------------------
    def notes(self) -> list[str]:
        """Explanations, not errors - shown separately from checks()."""
        out = []
        if self.plants and self.total:
            gap = round(self.total - self.core_plant_total, 2)
            if abs(gap) > 0.01 and abs(gap - self.conversion_total) <= 0.01:
                bits = []
                if self.sales_rakes:
                    bits.append(f"sales {self.sales_rakes:g}")
                if self.pellet_rakes:
                    bits.append(f"pellets {self.pellet_rakes:g}")
                out.append(
                    f"{gap:g} of {self.total:g} rakes routed as conversion "
                    f"({', '.join(bits) or 'unspecified'}); direct plant "
                    f"despatch {self.core_plant_total:g}")
        if self.pellet_accounts:
            named = ", ".join(f"{k} {v:g}"
                              for k, v in sorted(self.pellet_accounts.items()))
            out.append(f"pellet conversion by plant a/c: {named}")
        for code, mine in self.mines.items():
            if not mine.conversion:
                continue
            bits = []
            if mine.sales:
                bits.append(f"sales {mine.sales:g}")
            if mine.pellets:
                acc = ", ".join(f"{k} {v:g}" for k, v in
                                sorted(mine.pellet_accounts.items()))
                bits.append(f"pellets {mine.pellets:g}"
                            + (f" (a/c {acc})" if acc else ""))
            if mine.others:
                bits.append(f"others {mine.others:g}")
            out.append(f"{mine.name}: {mine.rakes:g} rakes = "
                       f"{mine.direct:g} direct + " + " + ".join(bits))
        return out

    def checks(self) -> list[str]:
        """Internal consistency of the message itself.

        Total Rakes is expected to equal direct plant despatch PLUS sales and
        pellets conversion. A gap between Total Rakes and the core plant lines
        alone is normal and is reported by notes(), not here.
        """
        issues = []
        mine_sum = sum(m.rakes for m in self.mines.values())
        if self.total and mine_sum != self.total:
            issues.append(f"mine total {mine_sum:g} != Total Rakes {self.total:g}")

        if self.total and self.plants:
            core, conv = self.core_plant_total, self.conversion_total
            if abs(core + conv - self.total) > 0.01:
                issues.append(
                    f"plant distribution {core:g} direct + {conv:g} conversion "
                    f"= {core + conv:g} != Total Rakes {self.total:g}")

        # Pellet bracket detail should add up to the Pellets line.
        pel = self.plants.get("Pellets")
        if pel and pel.accounts:
            named = round(sum(pel.accounts.values()), 2)
            if abs(named - pel.rakes) > 0.01:
                issues.append(f"pellet plant a/c detail {named:g} != "
                              f"Pellets {pel.rakes:g}")

        for code, mine in self.mines.items():
            if (mine.dest or mine.conversion) and mine.unallocated:
                issues.append(
                    f"{code} destination split {mine.allocated:g} "
                    f"({mine.direct:g} direct + {mine.conversion:g} conversion) "
                    f"!= {mine.rakes:g} rakes "
                    f"({mine.unallocated:g} unaccounted)")

        # The mine lines and the plant distribution are two statements of the
        # same day, so each side should reconcile with the other.
        for key, attr in (("Sales", "sales"), ("Pellets", "pellets")):
            stated = self.plants.get(key)
            from_mines = round(sum(getattr(m, attr)
                                   for m in self.mines.values()), 2)
            if stated and from_mines and abs(from_mines - stated.rakes) > 0.01:
                issues.append(f"{key.lower()} under the mines {from_mines:g} != "
                              f"{key} in plant distribution {stated.rakes:g}")

        by_plant: dict[str, float] = defaultdict(float)
        for mine in self.mines.values():
            for plant, qty in mine.dest.items():
                by_plant[plant] += qty
        for plant, qty in sorted(by_plant.items()):
            stated = self.plants.get(plant)
            if stated and abs(round(qty, 2) - stated.rakes) > 0.01:
                issues.append(f"{plant} from the mine lines {qty:g} != "
                              f"{plant} in plant distribution "
                              f"{stated.rakes:g}")

        # A rake-type line's plant split should add up to its bracketed count.
        for name, count in self.rake_types.items():
            split = round(sum(self.rake_type_dest.get(name, {}).values()), 2)
            if split and abs(split - count) > 0.01:
                issues.append(f"rake type {name} plant split {split:g} != "
                              f"{count:g} rakes")

        if not self.total:
            issues.append("Total Rakes not found")
        if not self.plan:
            issues.append("Daily COD Plan not found")
        if not self.mines:
            issues.append("no mine lines found")
        return issues


def _parse_date(m: re.Match) -> date | None:
    month = _MONTH_LOOKUP.get(m.group(2)[:3].lower())
    if not month:
        return None
    try:
        return date(int(m.group(3)), month, int(m.group(1)))
    except ValueError:
        return None


def parse_records(text: str) -> list[Record]:
    """Split the dump into one Record per 'D-Month-YYYY' heading."""
    lines = clean(text).split("\n")
    chunks: list[tuple[date, str, list[str]]] = []
    for line in lines:
        m = DATE_RE.search(line)
        day = _parse_date(m) if m else None
        if day:
            chunks.append((day, m.group(0), [line]))
        elif chunks:
            chunks[-1][2].append(line)

    records = [_build(day, label, "\n".join(buf)) for day, label, buf in chunks]
    # A re-sent or corrected message for the same date supersedes the earlier one.
    return sorted({r.day: r for r in records}.values(), key=lambda r: r.day)


def _parse_allocations(text: str) -> list[tuple[str, float, float]]:
    """Destination tokens on a line under a mine.

    Returns (plant code, lump, fines) triples. Handles both "(1 L+2 F)BSL"
    and bare "1FRSP" / "2LBSL" forms, and several tokens on one line.
    """
    found: list[tuple[str, float, float]] = []
    rest = text

    for m in ALLOC_LF_RE.finditer(text):
        code = m.group(3).upper()
        if code in DEST_CODES:
            lump = _num(m.group(1)) if m.group(1) else 0.0
            fines = _num(m.group(2)) if m.group(2) else 0.0
            found.append((code, lump, fines))
        rest = rest.replace(m.group(0), " ")

    for m in ALLOC_SIMPLE_RE.finditer(rest):
        code = m.group(3).upper()
        if code not in DEST_CODES:
            continue
        qty = _num(m.group(1))
        if m.group(2).upper() == "L":
            found.append((code, qty, 0.0))
        else:
            found.append((code, 0.0, qty))
    return found


def _add_allocations(mine: Mine, allocs: list[tuple[str, float, float]]) -> None:
    """Direct plant despatch under a mine: '(1 L+2 F)BSL', '1FRSP'."""
    for code, lump, fines in allocs:
        qty = lump + fines
        mine.lump = round(mine.lump + lump, 2)
        mine.fines = round(mine.fines + fines, 2)
        # An untagged OTH is conversion of an unstated kind, not a plant.
        if code == "OTH":
            mine.others = round(mine.others + qty, 2)
        elif code == "SLS":
            mine.sales = round(mine.sales + qty, 2)
            mine.sales_accounts["OTH"] = round(
                mine.sales_accounts.get("OTH", 0.0) + qty, 2)
        elif code == "PLT":
            mine.pellets = round(mine.pellets + qty, 2)
            # No plant a/c is named on a bare PLT tag, so book it to OTH the
            # same way an SLS tag is booked, or the rakes would disappear
            # from the mine-wise pellet a/c table.
            mine.pellet_accounts["OTH"] = round(
                mine.pellet_accounts.get("OTH", 0.0) + qty, 2)
        else:
            mine.dest[code] = round(mine.dest.get(code, 0.0) + qty, 2)


def _add_conversion(mine: Mine, kind: str, text: str) -> float:
    """A mine's own 'Pellets :  1FBSL  1FRSP  2FISP' or 'Sales: 2F OTH' line.

    These rakes are part of the mine's total but are NOT direct plant
    despatch - the plant codes name the account the conversion is booked to.
    Returns the rakes read off the line.
    """
    allocs = _parse_allocations(text)
    qty = round(sum(lump + fines for _c, lump, fines in allocs), 2)
    if not qty:                       # e.g. "Pellets : 4 Rakes"
        nums = RAKES_RE.findall(text) or re.findall(r"([\d.]+)", text)
        qty = _num(nums[-1]) if nums else 0.0
    accounts = (mine.pellet_accounts if kind == "pellets"
                else mine.sales_accounts)
    for code, lump, fines in allocs:
        accounts[code] = round(accounts.get(code, 0.0) + lump + fines, 2)
        mine.lump = round(mine.lump + lump, 2)
        mine.fines = round(mine.fines + fines, 2)
    if kind == "pellets":
        mine.pellets = round(mine.pellets + qty, 2)
    else:
        mine.sales = round(mine.sales + qty, 2)
    return qty


def _build(day: date, label: str, raw: str) -> Record:
    rec = Record(day=day, label=label, raw=raw.strip())
    section = ""
    current: Mine | None = None

    for line in raw.split("\n"):
        s = line.strip()
        if not s:
            continue
        low = s.lower()

        # --- section switches ---------------------------------------------
        if low.startswith("plant distribution"):
            section, current = "plant", None
            continue
        if low.startswith("rake type"):
            section, current = "rake", None
            continue
        if low.startswith("remarks"):
            section, current = "remarks", None
            continue
        if low.startswith("regards"):
            section, current = "", None
            continue

        # --- day totals ----------------------------------------------------
        if not rec.total:
            m = TOTAL_RE.search(s)
            if m:
                rec.total = _num(m.group(1))
                continue

        m = DAY_PLAN_RE.search(s)
        if m:
            rec.plan = _num(m.group(1))
            rec.mth_avg = _num(m.group(2))
            current = None
            continue

        m = CUMULATIVE_RE.search(s)
        if m and "cumulative" in low:
            rec.cumulative = _num(m.group(1))
            current = None
            continue

        m = GROUP_RE.match(s)
        if m:
            rec.groups[m.group(1).title()] = {
                "lump": _num(m.group(2)), "fines": _num(m.group(3)),
                "rakes": _num(m.group(4)),
            }
            current = None
            continue

        m = KTR_RE.match(s)
        if m:
            rec.ktr_dest = m.group(1).strip(" :") or "NIL"
            val = m.group(2)
            rec.ktr_rakes = 0.0 if val.lower() == "nil" else _num(val)
            current = None
            continue

        # --- mines (anywhere) ---------------------------------------------
        m = MINE_RE.match(s)
        if m:
            code, rakes = m.group(1), int(m.group(2))
            cod_m = COD_INLINE_RE.search(s)
            mine = rec.mines.get(code) or Mine(code)
            mine.rakes += rakes
            if cod_m:
                mine.cod = _num(cod_m.group(1))
            rec.mines[code] = mine
            current = mine
            # Destinations sometimes sit on the mine line itself; ignore the
            # "(Daily COD Plan ...)" tail so the plan is never read as a rake.
            head = s[:cod_m.start()] if cod_m else s
            _add_allocations(mine, _parse_allocations(head[m.end():]))
            continue

        # --- a mine's own sales / pellets conversion lines -------------------
        # "Pellets :  1FBSL  1FRSP  2FISP" or "Sales: 2F OTH" sitting under a
        # mine. These are the mine's rakes but not direct plant despatch, so
        # they must be read before the generic destination handling below.
        if section == "" and current is not None:
            m = MINE_CONV_RE.match(s)
            if m:
                kind = ("pellets" if m.group(1).lower().startswith("pell")
                        else "sales")
                _add_conversion(current, kind, s[m.end():])
                continue

        # --- plant distribution -------------------------------------------
        if section == "plant":
            m = PLANT_LF_RE.match(s)
            if m:
                cod_m = COD_INLINE_RE.search(s)
                rec.plants[m.group(1).upper()] = Plant(
                    code=m.group(1).upper(), lump=_num(m.group(2)),
                    fines=_num(m.group(3)), rakes=_num(m.group(4)),
                    cod=_num(cod_m.group(1)) if cod_m else 0.0)
                continue
            if PLANT_OTHER_RE.match(s) and COD_INLINE_RE.search(s):
                key = "Sales" if s.lower().startswith("sale") else "Pellets"
                cod_m = COD_INLINE_RE.search(s)
                # Strip the "(Daily COD Plan ...)" part before reading rakes,
                # so the plan figure is never mistaken for the actual.
                head = s[:cod_m.start()]
                head = head.rsplit("(", 1)[0] if "(" in head[-30:] else head
                nums = RAKES_RE.findall(head)
                rec.plants[key] = Plant(
                    code=key,
                    rakes=_num(nums[-1]) if nums else _bracket_sum(head),
                    cod=_num(cod_m.group(1)),
                    accounts=_bracket_accounts(head))
                continue

        # --- rake types ----------------------------------------------------
        if section == "rake":
            m = RAKE_TYPE_RE.match(s)
            if m:
                name = canonical_rake_type(m.group(1))
                rec.rake_types[name] = rec.rake_types.get(name, 0) + int(m.group(2))
                dest = rec.rake_type_dest.setdefault(name, {})
                for qty, code in RAKE_DEST_RE.findall(s[m.end():]):
                    key = code.upper()
                    if key in DEST_CODES:
                        dest[key] = round(dest.get(key, 0.0) + _num(qty), 2)
                continue

        # --- remarks -------------------------------------------------------
        if section == "remarks":
            cleaned = re.sub(r"^\d+\s*[.)]\s*", "", s).strip()
            if cleaned:
                rec.remarks.append(cleaned)
            continue

        # --- mine destination lines ----------------------------------------
        if section == "" and current is not None:
            allocs = _parse_allocations(s)
            if allocs:
                _add_allocations(current, allocs)
                continue

        # Anything left over is surfaced in the diagnostics so format drift
        # is visible rather than silently dropped.
        if section != "remarks" and not DATE_RE.search(s):
            rec.unparsed.append(f"[{section or 'mines'}] {s}")

    # Fall back to the sum of mines if the header total is missing.
    if not rec.total and rec.mines:
        rec.total = float(sum(m.rakes for m in rec.mines.values()))
    return rec


def _bracket_sum(text: str) -> float:
    """Sum rake counts inside a bracket list, e.g. '[2LOTH+3FOTH]' -> 5."""
    inner = re.search(r"\[(.*?)\]", text)
    if not inner:
        return 0.0
    return float(sum(_num(n) for n in re.findall(r"([\d.]+)\s*[LFlf]",
                                                 inner.group(1))))


def _bracket_accounts(text: str) -> dict[str, float]:
    """Plant accounts inside a bracket list: '[1FBSL,,1FRSP,2FISP]'."""
    inner = re.search(r"\[(.*?)\]", text)
    if not inner:
        return {}
    out: dict[str, float] = {}
    for qty, _lf, code in re.findall(r"([\d.]+)\s*([LlFf])\s*P?\s*([A-Za-z]{3})",
                                     inner.group(1)):
        key = code.upper()
        if key in DEST_CODES:
            out[key] = round(out.get(key, 0.0) + _num(qty), 2)
    return out


