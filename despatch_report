def _n(v) -> str:
    if v is None or v == "":
        return "-"
    return f"{v:,.0f}" if float(v).is_integer() else f"{v:,.2f}"


def _table(headers: list[str], rows: list[list[str]]) -> str:
    if not rows:
        return "  (none)"
    widths = [len(h) for h in headers]
    for row in rows:
        widths = [max(w, len(str(c))) for w, c in zip(widths, row)]
    out = [" | ".join(h.ljust(w) for h, w in zip(headers, widths)),
           "-+-".join("-" * w for w in widths)]
    out += [" | ".join(str(c).ljust(w) for c, w in zip(row, widths)) for row in rows]
    return "\n".join(out)


def _dict_table(rows: list[dict], cols: list[str] | None = None) -> str:
    if not rows:
        return "  (none)"
    cols = cols or list(rows[0].keys())
    return _table(cols, [[_n(r.get(c)) if isinstance(r.get(c), (int, float))
                          else (r.get(c) if r.get(c) is not None else "-")
                          for c in cols] for r in rows])


