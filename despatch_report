@dataclass
class Summary:
    records: list[Record]

    @property
    def days(self) -> int:
        return len(self.records)

    @property
    def total(self) -> float:
        return sum(r.total for r in self.records)

    @property
    def plan(self) -> float:
        return sum(r.plan for r in self.records)

    @property
    def cod_pct(self) -> float | None:
        return (self.total / self.plan * 100) if self.plan else None

    @property
    def stated_cumulative(self) -> float:
        return self.records[-1].cumulative if self.records else 0.0

    @property
    def calendar_days(self) -> int:
        """Calendar days of every month touched by the selection."""
        seen = {(r.day.year, r.day.month) for r in self.records}
        return sum(calendar.monthrange(y, m)[1] for y, m in seen)

    # ---- mine / plant -----------------------------------------------------
    def mine_rows(self, mine_filter: str | None = None) -> list[dict]:
        despatch: dict[str, float] = defaultdict(float)
        cod: dict[str, float] = defaultdict(float)
        for r in self.records:
            for code, mine in r.mines.items():
                if mine_filter and mine_filter.upper() not in code:
                    continue
                despatch[code] += mine.rakes
                cod[code] += mine.cod
        rows = []
        for code in sorted(despatch, key=_mine_sort):
            d, c = despatch[code], cod[code]
            rows.append({
                "Mine": code,
                "Name": MINE_NAMES.get(code, code),
                "Group": MINE_GROUP.get(code, ""),
                "Despatch": d,
                "COD Plan": round(c, 2),
                "Achievement %": round(d / c * 100, 1) if c else None,
                "% Share": round(d / self.total * 100, 1) if self.total else 0.0,
            })
        return rows

    def plant_rows(self) -> list[dict]:
        agg: dict[str, dict] = {}
        for r in self.records:
            for code, p in r.plants.items():
                a = agg.setdefault(code, {"rakes": 0.0, "cod": 0.0,
                                          "lump": 0.0, "fines": 0.0})
                a["rakes"] += p.rakes
                a["cod"] += p.cod
                a["lump"] += p.lump
                a["fines"] += p.fines
        rows = []
        for code in PLANT_KEYS:
            if code not in agg:
                continue
            a = agg[code]
            rows.append({
                "Plant": code,
                "Name": PLANT_NAMES.get(code, code),
                "Type": "Conversion" if code in CONVERSION_PLANTS else "Direct",
                "Despatch": round(a["rakes"], 2),
                "COD Plan": round(a["cod"], 2),
                "Achievement %": (round(a["rakes"] / a["cod"] * 100, 1)
                                  if a["cod"] else None),
                "Lump": round(a["lump"], 2),
                "Fines": round(a["fines"], 2),
            })
        return rows

    def pellet_account_rows(self) -> list[dict]:
        """Pellet conversion broken down by the receiving plant a/c."""
        agg: dict[str, float] = defaultdict(float)
        for r in self.records:
            for code, qty in r.pellet_accounts.items():
                agg[code] += qty
        total = sum(agg.values())
        return [{"Plant a/c": code,
                 "Name": PLANT_NAMES.get(code, code),
                 "Pellet Rakes": round(agg[code], 2),
                 "% Share": round(agg[code] / total * 100, 1) if total else 0.0}
                for code in sorted(agg, key=lambda c: -agg[c])]

    def mine_plant_matrix(self) -> tuple[list[dict], list[str]]:
        """Mine rows x destination columns, with Sales and Pellets.

        The plant columns are direct despatch only. A mine's own "Sales:" and
        "Pellets :" lines are its conversion rakes, reported in their own
        columns, so 'Direct' + Sales + Pellets = the mine's Total. The Others
        column only appears where an OTH tag was given without a Sales or
        Pellets label.
        """
        cols = [c for c in CORE_PLANTS]
        mine_dest: dict[str, dict[str, float]] = {}
        mine_total: dict[str, float] = defaultdict(float)
        mine_sales: dict[str, float] = defaultdict(float)
        mine_pellets: dict[str, float] = defaultdict(float)
        mine_others: dict[str, float] = defaultdict(float)
        for r in self.records:
            for code, mine in r.mines.items():
                d = mine_dest.setdefault(code, defaultdict(float))
                for plant, qty in mine.dest.items():
                    d[plant] += qty
                mine_total[code] += mine.rakes
                mine_sales[code] += mine.sales
                mine_pellets[code] += mine.pellets
                mine_others[code] += mine.others

        rows: list[dict] = []
        for code in sorted(mine_total, key=_mine_sort):
            d = mine_dest.get(code, {})
            direct = round(sum(d.values()), 2)
            row = {"Mine": MINE_NAMES.get(code, code), "Code": code}
            for c in cols:
                row[c] = round(d.get(c, 0.0), 2) or None
            row["Direct"] = direct or None
            row["Sales"] = round(mine_sales[code], 2) or None
            row["Pellets"] = round(mine_pellets[code], 2) or None
            row[OTHERS_COL] = round(mine_others[code], 2) or None
            allocated = round(direct + mine_sales[code] + mine_pellets[code]
                              + mine_others[code], 2)
            row["Unallocated"] = round(mine_total[code] - allocated, 2) or None
            row["Total"] = round(mine_total[code], 2)
            rows.append(row)

        plants = {p["Plant"]: p["Despatch"] for p in self.plant_rows()}
        total_row = {"Mine": "TOTAL", "Code": ""}
        for c in cols:
            total_row[c] = plants.get(c) or None
        total_row["Direct"] = round(sum(plants.get(c, 0.0)
                                       for c in CORE_PLANTS), 2) or None
        # Prefer the day's own Sales / Pellets figures from the plant
        # distribution; fall back to the mine lines when it is absent.
        total_row["Sales"] = (plants.get("Sales")
                              or round(sum(mine_sales.values()), 2) or None)
        total_row["Pellets"] = (plants.get("Pellets")
                                or round(sum(mine_pellets.values()), 2) or None)
        total_row[OTHERS_COL] = round(sum(mine_others.values()), 2) or None
        total_row["Unallocated"] = None
        total_row["Total"] = round(self.total, 2)
        rows.append(total_row)

        order = (["Mine"] + cols + ["Direct", "Sales", "Pellets", OTHERS_COL,
                                    "Unallocated", "Total"])
        return rows, order

    def mine_conversion_rows(self) -> tuple[list[dict], list[str]]:
        """The EGOM four-way split, per mine: direct / sales / pellets / total.

        This is the shape the daily message uses for Bolani, Barsuan and Kalta,
        and it is produced for every mine so the report stays uniform.
        """
        agg: dict[str, dict[str, float]] = {}
        for r in self.records:
            for code, mine in r.mines.items():
                a = agg.setdefault(code, {"direct": 0.0, "sales": 0.0,
                                          "pellets": 0.0, "others": 0.0,
                                          "total": 0.0, "cod": 0.0})
                a["direct"] += mine.direct
                a["sales"] += mine.sales
                a["pellets"] += mine.pellets
                a["others"] += mine.others
                a["total"] += mine.rakes
                a["cod"] += mine.cod

        rows = []
        for code in sorted(agg, key=_mine_sort):
            a = agg[code]
            rows.append({
                "Mine": MINE_NAMES.get(code, code),
                "Excl. Sales & Pellets": round(a["direct"], 2),
                "Sales": round(a["sales"], 2),
                "Pellets": round(a["pellets"], 2),
                OTHERS_COL: round(a["others"], 2) or None,
                "Total": round(a["total"], 2),
                "COD Plan": round(a["cod"], 2),
                "Achievement %": (round(a["total"] / a["cod"] * 100, 1)
                                  if a["cod"] else None),
            })
        if rows:
            keys = ["Excl. Sales & Pellets", "Sales", "Pellets", "Total",
                    "COD Plan"]
            total = {"Mine": "TOTAL"}
            for k in keys:
                total[k] = round(sum(x[k] for x in rows), 2)
            total[OTHERS_COL] = round(sum(x[OTHERS_COL] or 0.0
                                          for x in rows), 2) or None
            total["Achievement %"] = (round(total["Total"] / total["COD Plan"]
                                            * 100, 1)
                                      if total["COD Plan"] else None)
            rows.append(total)
        return rows, ["Mine", "Excl. Sales & Pellets", "Sales", "Pellets",
                      OTHERS_COL, "Total", "COD Plan", "Achievement %"]

    def mine_pellet_account_rows(self) -> tuple[list[dict], list[str]]:
        """Which plant a/c each mine's pellet conversion was booked to."""
        agg: dict[str, dict[str, float]] = {}
        for r in self.records:
            for code, mine in r.mines.items():
                if not mine.pellet_accounts:
                    continue
                a = agg.setdefault(code, defaultdict(float))
                for plant, qty in mine.pellet_accounts.items():
                    a[plant] += qty

        cols = [c for c in CORE_PLANTS
                if any(c in a for a in agg.values())]
        # A 'Pellets : 2F OTH' line names no plant a/c. Give it a column of
        # its own so the plant columns always add up to Pellet Rakes.
        if any(c not in CORE_PLANTS for a in agg.values() for c in a):
            cols.append(UNNAMED_AC)
        rows = []
        for code in sorted(agg, key=_mine_sort):
            a = agg[code]
            row = {"Mine": MINE_NAMES.get(code, code)}
            unnamed = round(sum(q for p, q in a.items()
                                if p not in CORE_PLANTS), 2)
            for c in cols:
                row[c] = ((unnamed if c == UNNAMED_AC
                           else round(a.get(c, 0.0), 2)) or None)
            row["Pellet Rakes"] = round(sum(a.values()), 2)
            rows.append(row)
        if rows:
            total = {"Mine": "TOTAL"}
            for c in cols + ["Pellet Rakes"]:
                total[c] = round(sum(x.get(c) or 0.0 for x in rows), 2) or None
            rows.append(total)
        return rows, ["Mine"] + cols + ["Pellet Rakes"]

    def daily_mine_rows(self, split: bool = True
                        ) -> tuple[list[dict], list[str]]:
        """One row per day, one column per mine, in EGOM reporting order.

        Bolani, Barsuan and Kalta are always broken out the way EGOM reports
        them - excluding sales and pellets, then sales, then pellets, then the
        mine's total - as is any other mine that shows conversion in the
        period. Pass split=False for a plain one-column-per-mine grid.
        """
        codes = self._mine_codes()
        broken = set()
        if split:
            broken = {c for c in codes if c in SPLIT_MINES}
            broken |= {c for c in codes
                       if any((m := r.mines.get(c)) and m.conversion
                              for r in self.records)}

        cols: list[str] = []
        for code in codes:
            name = MINE_NAMES.get(code, code)
            if code in broken:
                cols += [f"{name} (excl. S&P)", f"{name} Sales",
                         f"{name} Pellets", f"{name} Total"]
            else:
                cols.append(name)

        rows = []
        for r in self.records:
            row = {"Date": r.label, "Day": r.day_name}
            for code in codes:
                name = MINE_NAMES.get(code, code)
                mine = r.mines.get(code)
                if code in broken:
                    row[f"{name} (excl. S&P)"] = mine.direct if mine else 0
                    row[f"{name} Sales"] = mine.sales if mine else 0
                    row[f"{name} Pellets"] = mine.pellets if mine else 0
                    row[f"{name} Total"] = mine.rakes if mine else 0
                else:
                    row[name] = mine.rakes if mine else 0
            row["Sales"] = r.sales_rakes or None
            row["Pellets"] = r.pellet_rakes or None
            row["Total Rakes"] = r.total
            row["COD Plan"] = r.plan
            rows.append(row)
        order = (["Date", "Day"] + cols
                 + ["Sales", "Pellets", "Total Rakes", "COD Plan"])
        return rows, order

    def _mine_codes(self) -> list[str]:
        codes = [c for c in MINE_ORDER
                 if any(c in r.mines for r in self.records)]
        codes += sorted({c for r in self.records for c in r.mines
                         if c not in MINE_ORDER})
        return codes

    def daily_cod_rows(self) -> tuple[list[dict], list[str]]:
        """Daily COD plan, mine wise: one row per day, one column per mine.

        The last column is the day's stated Total COD plan, and a final
        'Mine Total' column adds the mine-wise plans so the two can be
        compared - they should agree when every mine line carries a plan.
        """
        codes = self._mine_codes()
        names = [MINE_NAMES.get(c, c) for c in codes]
        rows = []
        for r in self.records:
            row = {"Date": r.label, "Day": r.day_name}
            for code in codes:
                mine = r.mines.get(code)
                row[MINE_NAMES.get(code, code)] = (round(mine.cod, 2)
                                                   if mine else 0.0)
            row["Mine Total"] = round(sum(row[n] for n in names), 2)
            row["Stated COD Plan"] = round(r.plan, 2)
            rows.append(row)
        if rows:
            total = {"Date": "TOTAL", "Day": ""}
            for key in names + ["Mine Total", "Stated COD Plan"]:
                total[key] = round(sum(x[key] for x in rows), 2)
            rows.append(total)
        return rows, ["Date", "Day"] + names + ["Mine Total", "Stated COD Plan"]

    def daily_cod_vs_actual_rows(self) -> tuple[list[dict], list[str]]:
        """Per day and per mine: plan, actual and variance side by side."""
        rows = []
        for r in self.records:
            for code in self._mine_codes():
                mine = r.mines.get(code)
                if mine is None:
                    continue
                cod = round(mine.cod, 2)
                rows.append({
                    "Date": r.label,
                    "Day": r.day_name,
                    "Mine": MINE_NAMES.get(code, code),
                    "COD Plan": cod,
                    "Despatch": mine.rakes,
                    "Variance": round(mine.rakes - cod, 2),
                    "Achievement %": (round(mine.rakes / cod * 100, 1)
                                      if cod else None),
                })
        return rows, ["Date", "Day", "Mine", "COD Plan", "Despatch",
                      "Variance", "Achievement %"]

    def group_rows(self) -> list[dict]:
        agg: dict[str, dict] = {}
        for r in self.records:
            for name, g in r.groups.items():
                a = agg.setdefault(name, {"rakes": 0.0, "lump": 0.0, "fines": 0.0})
                a["rakes"] += g["rakes"]
                a["lump"] += g["lump"]
                a["fines"] += g["fines"]
        return [{"Group": k, "Despatch": round(v["rakes"], 2),
                 "Lump": round(v["lump"], 2), "Fines": round(v["fines"], 2),
                 "% Share": (round(v["rakes"] / self.total * 100, 1)
                             if self.total else 0.0)}
                for k, v in sorted(agg.items())]

    def rake_type_rows(self) -> list[tuple[str, int]]:
        agg: dict[str, int] = defaultdict(int)
        for r in self.records:
            for name, n in r.rake_types.items():
                if n:                      # drop reported nils, e.g. (0)
                    agg[name] += n
        return sorted(agg.items(), key=lambda kv: _rake_sort(kv[0]))

    def rake_type_matrix(self) -> tuple[list[dict], list[str]]:
        """Rake type against receiving plant - the relation table.

        OTH is "others", i.e. pellets and sales conversion, so it is reported
        under its own column rather than as a plant.
        """
        counts: dict[str, float] = defaultdict(float)
        dest: dict[str, dict[str, float]] = {}
        for r in self.records:
            for name, n in r.rake_types.items():
                if n:                      # a reported nil, e.g. SAIL GPWIS(0)
                    counts[name] += n
            for name, split in r.rake_type_dest.items():
                d = dest.setdefault(name, defaultdict(float))
                for code, qty in split.items():
                    d[code] += qty

        cols = [c for c in CORE_PLANTS
                if any(c in d for d in dest.values())]
        show_oth = any("OTH" in d for d in dest.values())

        rows: list[dict] = []
        for name in sorted(counts, key=_rake_sort):
            d = dest.get(name, {})
            row = {"Rake Type": name}
            for c in cols:
                row[c] = round(d.get(c, 0.0), 2) or None
            if show_oth:
                row[OTHERS_COL] = round(d.get("OTH", 0.0), 2) or None
            allocated = round(sum(d.values()), 2)
            row["Unsplit"] = round(counts[name] - allocated, 2) or None
            row["Rakes"] = round(counts[name], 2)
            rows.append(row)

        order = ["Rake Type"] + cols
        if show_oth:
            order.append(OTHERS_COL)
        order += ["Unsplit", "Rakes"]
        return rows, order

    def remark_rows(self) -> list[tuple[str, str]]:
        return [(r.label, text) for r in self.records for text in r.remarks]

    # ---- period aggregation ----------------------------------------------
    def _buckets(self, keyfunc):
        out: dict = {}
        for r in self.records:
            out.setdefault(keyfunc(r), []).append(r)
        return out

    def monthly_rows(self) -> list[dict]:
        rows = []
        for key, recs in self._buckets(lambda r: (r.day.year, r.day.month)).items():
            d0 = recs[0].day
            cal = month_days(d0)
            desp = sum(r.total for r in recs)
            plan = sum(r.plan for r in recs)
            rows.append({
                "Month": month_label(d0),
                "F.Y.": fy_label(d0),
                "Quarter": f"Q{fy_quarter(d0)}",
                "Days Reported": len(recs),
                "Calendar Days": cal,
                "Despatch": round(desp, 2),
                "COD Plan": round(plan, 2),
                "Variance": round(desp - plan, 2),
                "Achievement %": round(desp / plan * 100, 1) if plan else None,
                "Rakes/Day (calendar)": round(desp / cal, 2) if cal else None,
                "Rakes/Day (reported)": round(desp / len(recs), 2) if recs else None,
                "_sort": (fy_start_year(d0), fiscal_month_index(d0)),
            })
        return [self._drop_sort(r) for r in sorted(rows, key=lambda r: r["_sort"])]

    def quarter_rows(self) -> list[dict]:
        rows = []
        buckets = self._buckets(lambda r: (fy_start_year(r.day), fy_quarter(r.day)))
        for (fy_y, q), recs in buckets.items():
            months = {(r.day.year, r.day.month) for r in recs}
            cal = sum(calendar.monthrange(y, m)[1] for y, m in months)
            desp = sum(r.total for r in recs)
            plan = sum(r.plan for r in recs)
            rows.append({
                "Quarter": f"Q{q}",
                "F.Y.": f"F.Y.{fy_y}-{fy_y + 1}",
                "Months": len(months),
                "Days Reported": len(recs),
                "Calendar Days": cal,
                "Despatch": round(desp, 2),
                "COD Plan": round(plan, 2),
                "Variance": round(desp - plan, 2),
                "Achievement %": round(desp / plan * 100, 1) if plan else None,
                "Rakes/Day (calendar)": round(desp / cal, 2) if cal else None,
                "_sort": (fy_y, q),
            })
        return [self._drop_sort(r) for r in sorted(rows, key=lambda r: r["_sort"])]

    def fy_rows(self) -> list[dict]:
        rows = []
        for fy_y, recs in self._buckets(lambda r: fy_start_year(r.day)).items():
            months = {(r.day.year, r.day.month) for r in recs}
            cal = sum(calendar.monthrange(y, m)[1] for y, m in months)
            desp = sum(r.total for r in recs)
            plan = sum(r.plan for r in recs)
            rows.append({
                "F.Y.": f"F.Y.{fy_y}-{fy_y + 1}",
                "Months Covered": len(months),
                "Days Reported": len(recs),
                "Calendar Days": cal,
                "Despatch": round(desp, 2),
                "COD Plan": round(plan, 2),
                "Variance": round(desp - plan, 2),
                "Achievement %": round(desp / plan * 100, 1) if plan else None,
                "Rakes/Day (calendar)": round(desp / cal, 2) if cal else None,
                "_sort": (fy_y,),
            })
        return [self._drop_sort(r) for r in sorted(rows, key=lambda r: r["_sort"])]

    def weekly_rows(self) -> list[dict]:
        rows = []
        for key, recs in self._buckets(lambda r: r.week_key).items():
            d0 = recs[0].day
            start, end = week_bounds(d0)
            span = (end - start).days + 1
            desp = sum(r.total for r in recs)
            plan = sum(r.plan for r in recs)
            rows.append({
                "Week": week_label(d0),
                "Month": month_label(d0),
                "F.Y.": fy_label(d0),
                "From": start.isoformat(),
                "To": end.isoformat(),
                "Week Days": span,
                "Days Reported": len(recs),
                "Despatch": round(desp, 2),
                "COD Plan": round(plan, 2),
                "Variance": round(desp - plan, 2),
                "Achievement %": round(desp / plan * 100, 1) if plan else None,
                "Avg/Day (week days)": round(desp / span, 2) if span else None,
                "Avg/Day (reported)": round(desp / len(recs), 2) if recs else None,
                "_sort": key,
            })
        return [self._drop_sort(r) for r in sorted(rows, key=lambda r: r["_sort"])]

    @staticmethod
    def _drop_sort(row: dict) -> dict:
        row.pop("_sort", None)
        return row

    # ---- data quality -----------------------------------------------------
    def notes(self) -> list[tuple[str, str]]:
        return [(r.label, n) for r in self.records for n in r.notes()]

    def issues(self) -> list[tuple[str, str]]:
        out = [(r.label, issue) for r in self.records for issue in r.checks()]
        # Cross-check the stated cumulative against our own running total.
        # Only meaningful within a single month, since the message resets it.
        running = 0.0
        prev_key = None
        for r in self.records:
            if r.month_key != prev_key:
                running, prev_key = 0.0, r.month_key
            running += r.total
            if r.cumulative and abs(r.cumulative - running) > 0.01:
                out.append((r.label, f"stated cumulative {r.cumulative:g} != "
                                     f"running total {running:g}"))
        return out

    def unparsed_rows(self) -> list[tuple[str, str]]:
        return [(r.label, line) for r in self.records for line in r.unparsed]


def _mine_sort(code: str) -> tuple:
    return (MINE_ORDER.index(code) if code in MINE_ORDER else 99, code)


def _rake_sort(name: str) -> tuple:
    return (RAKE_TYPES.index(name) if name in RAKE_TYPES else 99, name)


def summarise(records: list[Record], month: str | None = None) -> Summary:
    if month:
        records = [r for r in records if r.month_key == month]
    return Summary(records=list(records))


