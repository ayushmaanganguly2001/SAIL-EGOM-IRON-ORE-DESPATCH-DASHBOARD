DATE_RE = re.compile(r"(\d{1,2})-([A-Za-z]+)-(\d{4})")
TOTAL_RE = re.compile(r"Total\s+Rakes\s*[:\-]?\s*(\d+(?:\.\d+)?)", re.I)

# "Daily COD Plan // Current Mth Avg : 22.09 // 19.00Rakes"
DAY_PLAN_RE = re.compile(
    r"Daily\s*COD\s*Plan\s*/{1,2}\s*Current\s*Mth\s*Avg\s*[:\-]?\s*"
    r"([\d.]+)\s*/{1,2}\s*([\d.]+)", re.I)

CUMULATIVE_RE = re.compile(r"Cumulative\s*[:\-]?\s*([\d.]+)\s*Rakes", re.I)

# Per-mine line: "KBR(4):   (Daily COD Plan- 2.84 Rakes)"
MINE_RE = re.compile(r"^([A-Z]{3})\s*\(\s*(\d+)\s*\)\s*:")
COD_INLINE_RE = re.compile(r"Daily\s*COD\s*Plan\s*[:\-]?\s*([\d.]+)", re.I)

# "Jharkhand Group of Mines  : 1.44L+6.56F: 8.00 Rakes"
GROUP_RE = re.compile(
    r"^(Jharkhand|Odisha)\s+Group\s+of\s+Mines\s*[:\-]?\s*"
    r"([\d.]+)\s*L\s*\+\s*([\d.]+)\s*F\s*[:\-]?\s*([\d.]+)\s*Rakes", re.I)

# "BSL : 1.00L+3.00F: 4 Rakes   (Daily COD Plan : 4.61 Rakes)"
PLANT_LF_RE = re.compile(
    r"^(BSL|DSP|RSP|ISP|BSP)\s*[:\-]\s*([\d.]+)\s*L\s*\+\s*([\d.]+)\s*F\s*"
    r"[:\-]?\s*([\d.]+)\s*Rakes", re.I)

# "Sales: [2F OTH] : 2 Rakes" / "Pellets : [1FBSL,,1FRSP,2FISP,1FBSP] : 5 Rakes"
PLANT_OTHER_RE = re.compile(r"^(Sales?|Pellets?)\s*[:\-]", re.I)
# The same label under a mine: "Pellets :  1FBSL  1FRSP  2FISP", "Sales: 2F OTH".
MINE_CONV_RE = PLANT_OTHER_RE
RAKES_RE = re.compile(r"([\d.]+)\s*Rakes", re.I)

# Mine -> plant allocation tokens, e.g. "(1  L+2  F)BSL" and "1FRSP".
ALLOC_LF_RE = re.compile(
    r"\(\s*([\d.]*)\s*[Ll]\s*\+\s*([\d.]*)\s*[Ff]\s*\)\s*P?([A-Za-z]{3})")
ALLOC_SIMPLE_RE = re.compile(r"([\d.]+)\s*([LlFf])\s*P?\s*([A-Za-z]{3})")

# Rake types: "SAIL GPWIS BOST(1) 1BSL", "Pvt. GPWIS(7) ...", "BOBSN(5) ..."
RAKE_TYPE_RE = re.compile(r"^([A-Za-z][A-Za-z.\s/]*?)\s*\(\s*(\d+)\s*\)")

# Plant split on a rake-type line: "|2OTH|1PBSL|1PRSP|2PISP|1PBSP", "4BSL".
# A leading P marks a private wagon and is not part of the plant code.
RAKE_DEST_RE = re.compile(r"(\d+(?:\.\d+)?)\s*P?\s*([A-Za-z]{3})")

# "KTR : BSL (2 Rakes )"  /  "KTR : NIL (Nil Rakes )"
KTR_RE = re.compile(r"^KTR\s*[:\-]?\s*(.*?)\s*\(\s*\*?\s*([\d.]+|Nil)\s*Rakes",
                    re.I)

MONTHS = ["January", "February", "March", "April", "May", "June",
          "July", "August", "September", "October", "November", "December"]
_MONTH_LOOKUP = {m[:3].lower(): i + 1 for i, m in enumerate(MONTHS)}


# ---------------------------------------------------------------------------
# Financial-year / week helpers
# ---------------------------------------------------------------------------

def fy_start_year(d: date) -> int:
    """Calendar year in which the financial year containing `d` began."""
    return d.year if d.month >= 4 else d.year - 1


def fy_label(d: date) -> str:
    y = fy_start_year(d)
    return f"F.Y.{y}-{y + 1}"


def fy_quarter(d: date) -> int:
    """1 for Apr-Jun, 2 for Jul-Sep, 3 for Oct-Dec, 4 for Jan-Mar."""
    return (d.month - 4) % 12 // 3 + 1


def quarter_label(d: date) -> str:
    return f"Q{fy_quarter(d)} {fy_label(d)}"


def month_label(d: date) -> str:
    return f"{MONTHS[d.month - 1][:3]}-{d.year % 100:02d}"


def fiscal_month_index(d: date) -> int:
    """0 for April ... 11 for March - used for FY-wise ordering."""
    return (d.month - 4) % 12


def month_days(d: date) -> int:
    return calendar.monthrange(d.year, d.month)[1]


def week_bounds(d: date) -> tuple[date, date]:
    """Sunday-to-Saturday week containing `d`, clipped to the month.

    A month that begins on, say, a Friday therefore has a two-day first week,
    and a month ending on a Sunday has a one-day last week.
    """
    # Python: Monday=0 ... Sunday=6. Offset back to the week's Sunday.
    offset = (d.weekday() + 1) % 7
    first = d.replace(day=1)
    last = d.replace(day=month_days(d))
    start = max(d - timedelta(days=offset), first)
    end = min(d + timedelta(days=6 - offset), last)
    return start, end


def week_index(d: date) -> int:
    """1-based index of `d`'s week within its month (weeks start on Sunday)."""
    idx = 1
    for day_num in range(2, d.day + 1):
        if date(d.year, d.month, day_num).weekday() == 6:   # Sunday
            idx += 1
    return idx


def week_label(d: date) -> str:
    start, end = week_bounds(d)
    return (f"W{week_index(d)} ({start.day:02d}-{end.day:02d} "
            f"{month_label(start)})")


# ---------------------------------------------------------------------------
# Text extraction
# ---------------------------------------------------------------------------

def extract_text(path: str) -> str:
    if path == "-":
        return sys.stdin.read()
    if os.path.splitext(path)[1].lower() == ".docx":
        return docx_text(path)
    with open(path, encoding="utf-8", errors="replace") as fh:
        return fh.read()


def docx_text(path: str) -> str:
    """Text from a .docx without third-party libraries (a .docx is a zip)."""
    with zipfile.ZipFile(path) as zf:
        xml = zf.read("word/document.xml").decode("utf-8", "replace")
    return docx_xml_to_text(xml)


def docx_xml_to_text(xml: str) -> str:
    xml = re.sub(r"<w:br[^>]*/>", "\n", xml)
    xml = re.sub(r"</w:p>", "\n", xml)
    xml = re.sub(r"<w:tab\b[^>]*/?>", "\t", xml)
    # The tag name must end here, otherwise <w:tbl>, <w:tcPr> and friends match
    # too and drag raw markup into the text.
    parts = re.findall(r"<w:t(?:\s[^>]*)?>(.*?)</w:t>|(\n)", xml, flags=re.S)
    text = "".join(a or b for a, b in parts)
    for entity, char in (("&amp;", "&"), ("&lt;", "<"), ("&gt;", ">"),
                         ("&quot;", '"'), ("&apos;", "'")):
        text = text.replace(entity, char)
    return text


def _num(token, default: float = 0.0) -> float:
    """Hand-typed messages carry stray dots, so never let float() abort a parse."""
    try:
        return float(token)
    except (TypeError, ValueError):
        try:
            return float(re.sub(r"\.(?=.*\.)|\.$", "", str(token)))
        except ValueError:
            return default


def clean(text: str) -> str:
    """Remove WhatsApp formatting markers and odd spaces."""
    text = text.replace(" ", " ").replace("​", "")
    text = text.replace("```", "")            # code fences round dates/plans
    text = re.sub(r"[*~]+", "", text)         # bold / strike markers
    return text


