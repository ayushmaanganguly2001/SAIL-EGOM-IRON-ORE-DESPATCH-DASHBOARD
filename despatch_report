def canonical_rake_type(raw: str) -> str:
    """Fold a reported rake-type name onto the EGOM reporting vocabulary.

    "BOXN", "BOXNHL" -> "BOXN/BOXNHL";  "SAIL GPWIS BOBSN" -> the SAIL GPWIS
    BOBSNM line. Names that cannot be placed are returned tidied but unchanged,
    so an unfamiliar type stays visible instead of being folded into the wrong
    bucket.
    """
    name = re.sub(r"\s+", " ", raw).strip()
    upper = name.upper().replace(".", "")
    family = next((canon for tag, canon in _WAGON_FAMILIES if tag in upper), "")

    if "PVT" in upper:
        return "Pvt. GPWIS BOXN/BOXNHL" if family in ("", "BOXN/BOXNHL") \
            else f"Pvt. GPWIS {family}"
    if "SAIL" in upper:
        if family == "BOXN/BOXNHL":
            return "SAIL GPWIS BOXNHL"
        if family == "BOBSNM":
            return "SAIL GPWIS BOBSNM"
        if family == "BOST":
            return "SAIL GPWIS BOSTHSM"
        return f"SAIL GPWIS {family}".strip() if family else name
    return family or name

