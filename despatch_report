def selftest() -> int:
    """Verify the parser against one known message."""
    fails: list[str] = []

    def check(what: str, got, want) -> None:
        if got != want:
            fails.append(f"{what}: got {got!r}, expected {want!r}")

    # --- calendar helpers --------------------------------------------------
    check("fy label Aug-2026", fy_label(date(2026, 8, 1)), "F.Y.2026-2027")
    check("fy label Mar-2026", fy_label(date(2026, 3, 31)), "F.Y.2025-2026")
    check("fy label Apr-2025", fy_label(date(2025, 4, 1)), "F.Y.2025-2026")
    check("Q1 is April", fy_quarter(date(2025, 4, 15)), 1)
    check("Q1 is June", fy_quarter(date(2025, 6, 30)), 1)
    check("Q2 is July", fy_quarter(date(2025, 7, 1)), 2)
    check("Q4 is March", fy_quarter(date(2026, 3, 1)), 4)
    check("month label", month_label(date(2026, 8, 1)), "Aug-26")
    # 1-Aug-2026 is a Saturday, so the month's first week is a single day.
    check("short first week", week_bounds(date(2026, 8, 1)),
          (date(2026, 8, 1), date(2026, 8, 1)))
    check("first week index", week_index(date(2026, 8, 1)), 1)
    # 2-Aug-2026 is the first Sunday: a full Sun-Sat week.
    check("full second week", week_bounds(date(2026, 8, 2)),
          (date(2026, 8, 2), date(2026, 8, 8)))
    check("second week index", week_index(date(2026, 8, 2)), 2)
    # 31-Aug-2026 is a Monday, so the last week is Sun 30 - Mon 31.
    check("short last week", week_bounds(date(2026, 8, 31)),
          (date(2026, 8, 30), date(2026, 8, 31)))

    # --- message parsing ---------------------------------------------------
    recs = parse_records(SAMPLE)
    check("record count", len(recs), 1)
    if not recs:
        print("SELFTEST FAILED: no records parsed")
        return 1
    r = recs[0]
    check("date", r.label, "1-August-2026")
    check("total rakes", r.total, 19.0)
    check("day COD plan", r.plan, 22.09)
    check("month avg", r.mth_avg, 19.0)
    check("cumulative", r.cumulative, 19.0)
    check("mine count", len(r.mines), 8)
    check("KBR rakes", r.mines["KBR"].rakes, 4)
    check("KBR cod", r.mines["KBR"].cod, 2.84)
    check("BOL rakes", r.mines["BOL"].rakes, 6)
    check("mine sum", sum(m.rakes for m in r.mines.values()), 19)
    check("rake types exclude mines", "BOXN" in r.mines, False)

    # mine -> plant destinations
    check("KBR dest BSL", r.mines["KBR"].dest.get("BSL"), 3.0)
    check("KBR dest RSP", r.mines["KBR"].dest.get("RSP"), 1.0)
    check("KBR fully allocated", r.mines["KBR"].unallocated, 0.0)
    check("GUA dest DSP", r.mines["GUA"].dest.get("DSP"), 1.0)
    # (0.22L+1.78F)ISP plus the separate "1F ISP Rajaburu" line.
    check("GUA dest ISP", r.mines["GUA"].dest.get("ISP"), 3.0)
    check("GUA fully allocated", r.mines["GUA"].unallocated, 0.0)

    # A mine's own Sales / Pellets lines are conversion, not direct despatch.
    bol = r.mines["BOL"]
    check("BOL no direct plant", bol.dest, {})
    check("BOL direct", bol.direct, 0.0)
    check("BOL pellets", bol.pellets, 4.0)
    check("BOL sales", bol.sales, 2.0)
    check("BOL pellet a/c", bol.pellet_accounts,
          {"BSL": 1.0, "RSP": 1.0, "ISP": 2.0})
    check("BOL sales a/c", bol.sales_accounts, {"OTH": 2.0})
    check("BOL conversion", bol.conversion, 6.0)
    check("BOL fully allocated", bol.unallocated, 0.0)
    bar = r.mines["BAR"]
    check("BAR direct RSP", bar.dest.get("RSP"), 1.0)
    check("BAR pellets", bar.pellets, 1.0)
    check("BAR pellet a/c", bar.pellet_accounts, {"BSP": 1.0})
    check("BAR four way split",
          (bar.direct, bar.sales, bar.pellets, bar.rakes), (1.0, 0.0, 1.0, 2))
    check("TAL direct RSP", r.mines["TAL"].dest.get("RSP"), 2.0)
    check("KAL direct BSL", r.mines["KAL"].dest.get("BSL"), 1.0)
    # The mine lines and the plant distribution must reconcile both ways.
    check("mine pellets tie to plant distribution",
          round(sum(m.pellets for m in r.mines.values()), 2), 5.0)
    check("mine sales tie to plant distribution",
          round(sum(m.sales for m in r.mines.values()), 2), 2.0)
    check("mine direct BSL ties",
          round(sum(m.dest.get("BSL", 0.0) for m in r.mines.values()), 2), 4.0)
    check("mine direct RSP ties",
          round(sum(m.dest.get("RSP", 0.0) for m in r.mines.values()), 2), 4.0)
    check("mine direct ISP ties",
          round(sum(m.dest.get("ISP", 0.0) for m in r.mines.values()), 2), 3.0)
    check("no mine reports untagged others",
          [c for c, m in r.mines.items() if m.others], [])

    # plant distribution
    check("plant count", len(r.plants), 7)
    check("BSL rakes", r.plants["BSL"].rakes, 4.0)
    check("BSL lump", r.plants["BSL"].lump, 1.0)
    check("Sales rakes", r.plants["Sales"].rakes, 2.0)
    check("Pellets rakes", r.plants["Pellets"].rakes, 5.0)
    check("core plant total", r.core_plant_total, 12.0)
    check("conversion total", r.conversion_total, 7.0)
    check("pellet accounts", r.pellet_accounts,
          {"BSL": 1.0, "RSP": 1.0, "ISP": 2.0, "BSP": 1.0})
    check("sales accounts", r.sales_accounts, {"OTH": 2.0})

    # Rake types fold onto the EGOM vocabulary, and each line's plant split
    # must tie to its bracketed count.
    check("BOBSN folds to BOBSNM", r.rake_types.get("BOBSNM"), 5)
    check("BOXN folds to BOXN/BOXNHL", r.rake_types.get("BOXN/BOXNHL"), 1)
    check("BOYN folds to BOYN/BOYEL", r.rake_types.get("BOYN/BOYEL"), 4)
    check("BOSM stays BOSM", r.rake_types.get("BOSM"), 1)
    check("Pvt GPWIS rake type", r.rake_types.get("Pvt. GPWIS BOXN/BOXNHL"), 7)
    check("SAIL BOBSN folds", r.rake_types.get("SAIL GPWIS BOBSNM"), 1)
    check("canonical BOXNHL", canonical_rake_type("BOXNHL"), "BOXN/BOXNHL")
    check("canonical SAIL GPWIS BOST",
          canonical_rake_type("SAIL GPWIS BOST"), "SAIL GPWIS BOSTHSM")
    check("canonical unknown kept", canonical_rake_type("WIDGET"), "WIDGET")
    # "Pvt. GPWIS(7) |2OTH|1PBSL|1PRSP|2PISP|1PBSP" -> P is a private-wagon
    # marker, OTH is pellets + sales, and the split totals the bracketed 7.
    pvt = r.rake_type_dest["Pvt. GPWIS BOXN/BOXNHL"]
    check("pvt split BSL", pvt.get("BSL"), 1.0)
    check("pvt split RSP", pvt.get("RSP"), 1.0)
    check("pvt split ISP", pvt.get("ISP"), 2.0)
    check("pvt split BSP", pvt.get("BSP"), 1.0)
    check("pvt split OTH", pvt.get("OTH"), 2.0)
    check("pvt split ties to count", sum(pvt.values()), 7.0)
    check("BOBSNM split",
          r.rake_type_dest["BOBSNM"], {"RSP": 3.0, "ISP": 2.0})
    check("KTR dest", r.ktr_dest.upper(), "NIL")
    check("KTR rakes", r.ktr_rakes, 0.0)
    check("remark count", len(r.remarks), 2)
    check("group count", len(r.groups), 2)
    check("Jharkhand rakes", r.groups["Jharkhand"]["rakes"], 8.0)

    # The core plants alone (12) fall short of Total Rakes (19); the 7 rake
    # difference is sales + pellets conversion, which must NOT be an error.
    check("no false plant mismatch",
          [i for i in r.checks() if "plant distribution" in i], [])
    check("conversion explained",
          any("routed as conversion" in n for n in r.notes()), True)
    check("internal checks clean", r.checks(), [])

    # --- period aggregation ------------------------------------------------
    s = summarise(recs)
    check("monthly rows", len(s.monthly_rows()), 1)
    mrow = s.monthly_rows()[0]
    check("monthly label", mrow["Month"], "Aug-26")
    check("monthly fy", mrow["F.Y."], "F.Y.2026-2027")
    check("monthly quarter", mrow["Quarter"], "Q2")
    check("monthly calendar days", mrow["Calendar Days"], 31)
    check("monthly rakes/day", mrow["Rakes/Day (calendar)"], round(19 / 31, 2))
    check("quarter rows", len(s.quarter_rows()), 1)
    check("fy rows", len(s.fy_rows()), 1)
    check("weekly rows", len(s.weekly_rows()), 1)
    wrow = s.weekly_rows()[0]
    check("weekly week days", wrow["Week Days"], 1)
    check("weekly avg", wrow["Avg/Day (week days)"], 19.0)

    rows, cols = s.mine_plant_matrix()
    check("matrix has total row", rows[-1]["Mine"], "TOTAL")
    check("matrix total sales", rows[-1]["Sales"], 2.0)
    check("matrix total pellets", rows[-1]["Pellets"], 5.0)
    check("matrix mine order", [x["Mine"] for x in rows[:4]],
          ["Manoharpur", "Gua", "Kiriburu", "Meghataburu"])
    check("matrix cols start", cols[:3], ["Mine", "BSL", "DSP"])
    check("matrix has others col", OTHERS_COL in cols, True)
    check("matrix ends", cols[-2:], ["Unallocated", "Total"])

    conv_rows, conv_cols = s.mine_conversion_rows()
    check("conversion cols", conv_cols[:4],
          ["Mine", "Excl. Sales & Pellets", "Sales", "Pellets"])
    bol_row = next(x for x in conv_rows if x["Mine"] == "Bolani")
    check("conversion Bolani four way",
          (bol_row["Excl. Sales & Pellets"], bol_row["Sales"],
           bol_row["Pellets"], bol_row["Total"]),
          (0.0, 2.0, 4.0, 6.0))
    check("conversion total row",
          (conv_rows[-1]["Mine"], conv_rows[-1]["Excl. Sales & Pellets"],
           conv_rows[-1]["Sales"], conv_rows[-1]["Pellets"],
           conv_rows[-1]["Total"]),
          ("TOTAL", 12.0, 2.0, 5.0, 19.0))

    pa_rows, pa_cols = s.mine_pellet_account_rows()
    check("pellet a/c cols", pa_cols, ["Mine", "BSL", "RSP", "ISP", "BSP",
                                       "Pellet Rakes"])
    check("pellet a/c Bolani",
          {k: v for k, v in
           next(x for x in pa_rows if x["Mine"] == "Bolani").items()
           if v is not None},
          {"Mine": "Bolani", "BSL": 1.0, "RSP": 1.0, "ISP": 2.0,
           "Pellet Rakes": 4.0})
    check("pellet a/c total", pa_rows[-1]["Pellet Rakes"], 5.0)

    rows, cols = s.daily_mine_rows()
    check("daily mine row count", len(rows), 1)
    check("daily mine day column", cols[1], "Day")
    check("daily mine first mine col", cols[2], "Manoharpur")
    # Bolani, Barsuan and Kalta are always shown the EGOM way: excluding
    # sales and pellets, then sales, then pellets, then the mine total.
    check("daily mine Bolani split",
          (rows[0]["Bolani (excl. S&P)"], rows[0]["Bolani Sales"],
           rows[0]["Bolani Pellets"], rows[0]["Bolani Total"]),
          (0.0, 2.0, 4.0, 6))
    check("daily mine Barsuan split",
          (rows[0]["Barsuan (excl. S&P)"], rows[0]["Barsuan Sales"],
           rows[0]["Barsuan Pellets"], rows[0]["Barsuan Total"]),
          (1.0, 0.0, 1.0, 2))
    check("daily mine Kalta split",
          (rows[0]["Kalta (excl. S&P)"], rows[0]["Kalta Sales"],
           rows[0]["Kalta Pellets"], rows[0]["Kalta Total"]),
          (1.0, 0.0, 0.0, 1))
    # A mine with no conversion keeps a single column.
    check("daily mine Gua single col", rows[0]["Gua"], 4)
    check("daily mine unsplit grid",
          "Bolani" in s.daily_mine_rows(split=False)[1], True)
    check("daily mine total", rows[0]["Total Rakes"], 19.0)
    # 1-Aug-2026 is a Saturday.
    check("day name", rows[0]["Day"], "Sat")
    check("record day name", r.day_name, "Sat")

    cod_rows, cod_cols = s.daily_cod_rows()
    check("daily cod cols", cod_cols[:2], ["Date", "Day"])
    check("daily cod ends", cod_cols[-2:], ["Mine Total", "Stated COD Plan"])
    check("daily cod has total row", cod_rows[-1]["Date"], "TOTAL")
    check("daily cod stated plan", cod_rows[0]["Stated COD Plan"],
          round(r.plan, 2))
    check("daily cod mine total ties",
          cod_rows[0]["Mine Total"],
          round(sum(m.cod for m in r.mines.values()), 2))

    va_rows, va_cols = s.daily_cod_vs_actual_rows()
    check("cod vs actual cols", va_cols[2], "Mine")
    check("cod vs actual rows", len(va_rows), len(r.mines))
    check("cod vs actual variance",
          va_rows[0]["Variance"],
          round(va_rows[0]["Despatch"] - va_rows[0]["COD Plan"], 2))

    rows, cols = s.rake_type_matrix()
    check("rake matrix cols", cols[0], "Rake Type")
    check("rake matrix has others", "Others (pellets + sales)" in cols, True)
    check("rake matrix ends with rakes", cols[-1], "Rakes")
    pvt_row = next(x for x in rows if x["Rake Type"].startswith("Pvt."))
    check("rake matrix pvt total", pvt_row["Rakes"], 7.0)
    check("rake matrix pvt others", pvt_row["Others (pellets + sales)"], 2.0)
    check("rake matrix pvt fully split", pvt_row["Unsplit"], None)
    check("rake matrix order puts pvt first", rows[0]["Rake Type"],
          "Pvt. GPWIS BOXN/BOXNHL")

    if fails:
        print(f"SELFTEST: {len(fails)} failure(s)")
        for f in fails:
            print(f"  - {f}")
        return 1
    print("SELFTEST PASSED - parser matches the known message format.")
    return 0


