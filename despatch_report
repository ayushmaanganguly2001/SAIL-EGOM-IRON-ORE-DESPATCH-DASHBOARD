def pick_file() -> str | None:
    try:
        import tkinter as tk
        from tkinter import filedialog
    except ImportError:
        return None
    root = tk.Tk()
    root.withdraw()
    path = filedialog.askopenfilename(
        title="Select the despatch messages file",
        filetypes=[("Word / text", "*.docx *.txt *.md"), ("All files", "*.*")])
    root.destroy()
    return path or None


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Despatch performance report.")
    ap.add_argument("source", nargs="?",
                    help="path to .docx / .txt, or '-' for stdin "
                         "(a file picker opens if omitted)")
    ap.add_argument("--month", help="filter to one month, YYYY-MM")
    ap.add_argument("--fy", type=int, metavar="YEAR",
                    help="filter to a financial year by its start year, "
                         "e.g. 2025 for F.Y.2025-2026")
    ap.add_argument("--mine", help="filter mine table to codes containing this")
    ap.add_argument("--csv", metavar="PATH")
    ap.add_argument("--excel", metavar="PATH")
    ap.add_argument("--charts", metavar="DIR")
    ap.add_argument("--diagnose", action="store_true",
                    help="show what each pattern matched per day")
    ap.add_argument("--dump-text", metavar="PATH",
                    help="write the text extracted from the .docx")
    ap.add_argument("--selftest", action="store_true",
                    help="check the parser against a known message")
    args = ap.parse_args(argv)

    if args.selftest:
        return selftest()

    if not args.source:
        args.source = pick_file()
        if not args.source:
            ap.print_usage()
            print("\nNo file chosen.", file=sys.stderr)
            return 1
        print(f"Reading: {args.source}\n")

    try:
        text = extract_text(args.source)
    except FileNotFoundError:
        print(f"File not found: {args.source}", file=sys.stderr)
        return 1
    except (zipfile.BadZipFile, KeyError):
        print(f"Not a readable .docx: {args.source}", file=sys.stderr)
        return 1

    if args.dump_text:
        with open(args.dump_text, "w", encoding="utf-8") as fh:
            fh.write(text)
        print(f"Extracted text written: {args.dump_text}")

    records = parse_records(text)
    if args.diagnose:
        diagnose(text, records)
    if not records:
        print("No dated records found (expected e.g. 1-August-2026).",
              file=sys.stderr)
        return 1

    months = sorted({r.month_key for r in records})
    if args.month and args.month not in months:
        print(f"No data for {args.month}. Available: {', '.join(months)}",
              file=sys.stderr)
        return 1

    if args.fy:
        records = [r for r in records if fy_start_year(r.day) == args.fy]
        if not records:
            print(f"No data for F.Y.{args.fy}-{args.fy + 1}.", file=sys.stderr)
            return 1

    s = summarise(records, month=args.month)
    if args.mine:
        print(f"(mine filter: {args.mine})")
    suffix = ""
    if args.month:
        suffix = f" - {args.month}"
    elif args.fy:
        suffix = f" - F.Y.{args.fy}-{args.fy + 1}"
    print_report(s, title="SAIL-EGOM-IRON ORE-DESPATCH-REPORT" + suffix,
                 mine_filter=args.mine)
    if len(months) > 1 and not args.month:
        print(f"Months in file: {', '.join(months)} "
              f"(use --month YYYY-MM for one)\n")

    if args.csv:
        write_csv(s, args.csv)
    if args.excel:
        write_excel(s, args.excel)
    if args.charts:
        write_charts(s, args.charts)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
